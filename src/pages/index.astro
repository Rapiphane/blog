---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1 flex flex-col items-center"
  >
    <section
      id="hero"
      class="flex w-full max-w-2xl flex-col items-center pt-4 pb-6 text-center"
    >
      <div
        class="80 30 max-w-2xl rounded-2xl border border-zinc-800 bg-zinc-900 p-8 backdrop-blur-sm"
      >
        <div
          class="mb-3 inline-flex items-center gap-2 rounded-full border border-zinc-800 bg-zinc-900/80 px-3 py-1 font-mono text-xs text-zinc-400 backdrop-blur"
        >
          <span class="h-2 w-2 animate-pulse rounded-full bg-emerald-500"
          ></span>
          <span>Software Developer</span>
        </div>
        <h1 class="my-2 block text-4xl font-bold text-zinc-100 sm:text-5xl">
          Hi, I am Rapiphane
        </h1>
        <p class="mt-1 text-base text-zinc-400">Introduction will go here.</p>
        {
          socials.length > 0 && (
            <div class="mt-4 flex items-center justify-center">
              <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
                {/* {t.home.socialLinks}: */}
              </div>
              <Socials />
            </div>
          )
        }
      </div>
    </section>

    <!-- Status Badge -->

    <!-- Heading -->

    <!-- Bio Text -->

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class="flex w-full max-w-2xl flex-col items-center pt-12 pb-6"
        >
          <h2 class="text-white-400 mb-4 text-5xl font-semibold tracking-wider uppercase">
            {t.home.featured}
          </h2>
          <ul class="flex w-full flex-col gap-4">
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section
          id="recent-posts"
          class="flex w-full max-w-2xl flex-col items-center pt-12 pb-6"
        >
          <h2 class="mb-4 text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul class="flex w-full flex-col gap-4">
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div
      class="my-8 flex flex-col items-center text-center transition-transform duration-200 hover:scale-[1.01] hover:rotate-2"
    >
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
</Layout>
<Footer />

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
